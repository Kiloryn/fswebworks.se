# Add project environment variables here.
# Copy to .env.local and fill in values.

# Contact form – sent via Resend (https://resend.com, free tier: 100 emails/day)
RESEND_API_KEY=
# Where to receive submissions. Until you verify fswebworks.se in Resend, set this to the email you signed up with (e.g. your GitHub-linked email), or Resend will reject the send.
CONTACT_EMAIL=fredrik@fswebworks.se
# Optional: after verifying your domain in Resend, set a proper "from" address
# RESEND_FROM=FSwebworks <kontakt@fswebworks.se>
