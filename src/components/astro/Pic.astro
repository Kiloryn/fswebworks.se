---
interface Props {
  src: string;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  priority?: boolean;
}
const { src, alt, class: className = "", width, height, priority = false } = Astro.props;
const q = src.indexOf("?");
const path = q === -1 ? src : src.slice(0, q);
const query = q === -1 ? "" : src.slice(q);
const webp = path.replace(/\.(jpe?g)$/i, ".webp");
---

<picture class="contents">
  <source srcset={`${webp}${query}`} type="image/webp" />
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    class:list={["outline-none", className]}
    loading={priority ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={priority ? "high" : "low"}
  />
</picture>

