---
import { EXAMPLES } from "../../lib/site";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
interface Props { current: string }
const { current } = Astro.props;
---
<div class="sticky top-0 z-[60] border-b border-gold/30 bg-canvas text-fg">
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-2 px-3 md:h-16 md:gap-3 md:px-8">
    <a href="/" class="inline-flex h-10 shrink-0 items-center justify-center gap-1.5 rounded-sm bg-gold px-2.5 text-sm font-medium text-gold-fg hover:bg-gold-2 md:h-11 md:px-4"><Icon name="arrow-left" class="size-4" /><span class="hidden md:inline">Tillbaka till startsidan</span><span class="md:hidden">Start</span></a>
    <Logo class="hidden lg:inline-flex" />
    <p class="hidden text-[12px] text-muted xl:block">Interaktivt exempel från FSwebworks</p>
    <label class="sr-only" for="demo-switch">Byt branschexempel</label>
    <select id="demo-switch" class="h-10 min-w-0 flex-1 rounded-sm border border-line bg-ink-2 px-2 text-[13px] text-fg md:h-11 md:max-w-[16rem] md:flex-none">{EXAMPLES.map((example) => <option value={example.slug} selected={example.slug === current}>{example.name}</option>)}</select>
    <a href="/examples" class="inline-flex h-10 shrink-0 items-center rounded-sm border border-gold/40 px-2.5 text-[13px] text-gold hover:bg-gold/10 md:h-11 md:px-3"><span class="md:hidden">Alla</span><span class="hidden md:inline">Alla exempel</span></a>
  </div>
</div>
<script>document.querySelector<HTMLSelectElement>("#demo-switch")?.addEventListener("change", (event) => location.assign(`/${(event.currentTarget as HTMLSelectElement).value}`));</script>

