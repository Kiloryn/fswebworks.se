---
import "../styles.css";
import { SITE } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  preloadHero?: boolean;
}

const {
  title = `${SITE.name} – ${SITE.tagline}`,
  description = SITE.description,
  preloadHero = false,
} = Astro.props;
---

<!doctype html>
<html lang="sv" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0a08" />
    <meta name="color-scheme" content="only light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {preloadHero && <link rel="preload" href="/videos/hero-poster.jpg" as="image" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;1,9..144,560&family=Outfit:wght@400;500;600&display=swap"
    />
    <title>{title}</title>
  </head>
  <body class="bg-canvas text-fg">
    <slot />
  </body>
</html>

