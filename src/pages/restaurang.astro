---
export const prerender = true;
import DemoLayout from "../layouts/DemoLayout.astro";
import Pic from "../components/astro/Pic.astro";
import DemoBanner from "../components/astro/DemoBanner.astro";
import DemoExit from "../components/astro/DemoExit.astro";
import DemoPhoneLink from "../components/astro/DemoPhoneLink.astro";

const lunch = [
  ["Dagens pasta", "145 kr"],
  ["Kycklingsallad", "155 kr"],
  ["Pasta aglio e olio", "135 kr"],
];

const dinner = [
  ["Burrata, tomat och olja", "135 kr"],
  ["Tagliatelle, tomat och basilika", "195 kr"],
  ["Kalvgryta med gremolata", "285 kr"],
  ["Tiramisu", "95 kr"],
];

const reviews = [
  {
    quote: "Pasta som smakar som i Rom, utan att det blir teater av det. Vi tar alltid husets rödvin.",
    name: "Klara, Södermalm",
  },
  {
    quote: "Litet ställe, bordet var dukat när vi kom. Ingen stress, inget surr.",
    name: "Johan och Mia",
  },
  {
    quote: "Bästa lunchen i kvarteret. Dagens pasta, 25 minuter, tillbaka på jobbet.",
    name: "Erik, Folkungagatan",
  },
];
---
<DemoLayout title="Trattoria Nove – exempelsida">
<div class="min-h-dvh bg-[#f6eee4] text-[#1a0f0d]">
      <DemoBanner current="restaurang" />
      <header class="border-b border-[#1a0f0d]/10 bg-[#1a0f0d] text-[#f3e6d8]">
        <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-5 py-4 md:px-8">
          <p class="min-w-0 truncate font-display text-xl italic md:text-2xl">
            Trattoria Nove
          </p>
          <nav class="hidden items-center gap-7 text-sm text-[#e2d0c0] md:flex">
            <a href="#meny" class="hover:text-[#f3e6d8]">
              Meny
            </a>
            <a href="#boka" class="hover:text-[#f3e6d8]">
              Boka
            </a>
            <a href="#hitta" class="hover:text-[#f3e6d8]">
              Hitta hit
            </a>
          </nav>
          <a
            href="#boka"
            class="inline-flex h-11 shrink-0 items-center rounded-sm bg-[#f3e6d8] px-4 text-sm font-medium text-[#1a0f0d]"
          >
            Boka bord
          </a>
        </div>
      </header>

      <section class="relative isolate text-[#f3e6d8]">
        <Pic
          src="/images/restaurang.jpg?v=5"
          alt="Tagliatelle och ett glas vin"
          class="h-[62dvh] w-full object-cover md:h-[82vh]"
          width={1400}
          height={1050}
          priority
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#1a0f0d] via-[#1a0f0d]/50 to-transparent" />
        <div class="absolute inset-x-0 bottom-0 mx-auto max-w-6xl px-5 pb-10 md:px-8 md:pb-14">
          <p class="text-[11px] uppercase tracking-[0.28em] text-[#d4b480]">
            Folkungagatan · Södermalm
          </p>
          <h1 class="mt-3 max-w-[12ch] font-display text-[2.6rem] italic leading-[0.98] md:text-7xl">
            Pasta. Vin. Inget krångel.
          </h1>
          <p class="mt-4 max-w-md text-sm text-[#e2d0c0] md:text-base">
            En liten italiensk krog. Handgjord pasta, korta menyer, husets
            rödvin. Boka bord eller kom förbi på lunchen.
          </p>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row">
            <a
              href="#boka"
              class="inline-flex h-12 items-center justify-center rounded-sm bg-[#f3e6d8] px-5 text-sm font-medium text-[#1a0f0d]"
            >
              Boka bord
            </a>
            <a
              href="#meny"
              class="inline-flex h-12 items-center justify-center rounded-sm border border-[#f3e6d8]/40 px-5 text-sm"
            >
              Se menyn
            </a>
          </div>
        </div>
      </section>

      <section class="bg-[#eadccb]">
        <div class="mx-auto grid max-w-6xl gap-8 px-5 py-8 sm:grid-cols-3 md:px-8">
          {[
            ["Lunch", "mån–fre 11–14"],
            ["Middag", "tis–sön 17–23"],
            ["Bord", "2–8 personer"],
          ].map(([k, v]) => (
            <div>
              <p class="font-display text-2xl italic text-[#8a6234]">{k}</p>
              <p class="mt-1 text-sm text-[#5c4338]">{v}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="meny" class="bg-[#f6eee4] px-5 py-16 md:px-8">
        <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-2">
          <div>
            <p class="text-[11px] uppercase tracking-[0.28em] text-[#8a6234]">
              Lunch · mån–fre
            </p>
            <h2 class="mt-2 font-display text-3xl italic">Kort och klart.</h2>
            <ul class="mt-8 divide-y divide-[#1a0f0d]/10 border-y border-[#1a0f0d]/10">
              {lunch.map(([n, p]) => (
                <li class="flex items-baseline justify-between gap-4 py-5">
                  <p class="font-display text-xl italic md:text-2xl">{n}</p>
                  <p class="shrink-0 tabular-nums text-[#8a6234]">{p}</p>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <p class="text-[11px] uppercase tracking-[0.28em] text-[#8a6234]">
              Kväll · tis–sön
            </p>
            <h2 class="mt-2 font-display text-3xl italic">Huset lagar pasta.</h2>
            <ul class="mt-8 divide-y divide-[#1a0f0d]/10 border-y border-[#1a0f0d]/10">
              {dinner.map(([n, p]) => (
                <li class="flex items-baseline justify-between gap-4 py-5">
                  <p class="font-display text-xl italic md:text-2xl">{n}</p>
                  <p class="shrink-0 tabular-nums text-[#8a6234]">{p}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section class="bg-[#2a1814] px-5 py-16 text-[#f3e6d8] md:px-8">
        <div class="mx-auto max-w-6xl">
          <h2 class="font-display text-3xl italic">De tar samma bord igen.</h2>
          <div class="mt-10 grid gap-4 md:grid-cols-3">
            {reviews.map((r) => (
              <figure class="bg-[#3a221c] p-6 md:p-8">
                <blockquote class="font-display text-xl italic leading-snug">
                  “{r.quote}”
                </blockquote>
                <figcaption class="mt-6 text-sm text-[#d4b480]">{r.name}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <section id="boka" class="bg-[#f3e6d8] px-5 py-16 text-[#1a0f0d] md:px-8">
        <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-2">
          <div>
            <h2 class="font-display text-4xl italic">Boka bord</h2>
            <p class="mt-4 max-w-md">
              Lunch utan bokning går ofta bra. Till kvällen vill vi ha borden
              klara – ring eller boka här.
            </p>
            <p class="mt-6 text-sm">
              Lunch mån–fre 11–14
              <br />
              Middag tis–sön 17–23
              <br />
              Folkungagatan 48, Södermalm
            </p>
            <DemoPhoneLink
              tel="08-567 890 12"
              class="mt-6 inline-block font-display text-3xl italic md:text-4xl"
            >
              08-567 890 12
            </DemoPhoneLink>
          </div>
          <form data-demo-form
            class="bg-[#1a0f0d] p-6 text-[#f3e6d8] md:p-8"
          >
            <p class="font-display text-2xl italic">Kvällsbord</p>
            <div class="mt-6 grid gap-4 sm:grid-cols-2">
              <label class="text-[11px] uppercase tracking-[0.16em] text-[#d4b480]">
                Gäster
                <select class="mt-2 h-12 w-full rounded-sm border border-white/15 bg-[#241614] px-3 text-sm text-[#f3e6d8]">
                  {["2", "3", "4", "5", "6", "7", "8"].map((n) => (
                    <option>{n} personer</option>
                  ))}
                </select>
              </label>
              <label class="text-[11px] uppercase tracking-[0.16em] text-[#d4b480]">
                Tid
                <select class="mt-2 h-12 w-full rounded-sm border border-white/15 bg-[#241614] px-3 text-sm text-[#f3e6d8]">
                  {["17.30", "18.00", "18.30", "19.00", "19.30", "20.00"].map((n) => (
                    <option>{n}</option>
                  ))}
                </select>
              </label>
            </div>
            <label class="mt-4 block text-[11px] uppercase tracking-[0.16em] text-[#d4b480]">
              Namn
              <input class="mt-2 h-12 w-full rounded-sm border border-white/15 bg-[#241614] px-3 text-sm text-[#f3e6d8]" />
            </label>
            <button
              type="submit"
              class="mt-6 inline-flex h-12 w-full items-center justify-center rounded-sm bg-[#f3e6d8] text-sm font-medium text-[#1a0f0d]"
            >
              Boka bord
            </button>
            <p class="mt-3 text-center text-xs text-[#e2d0c0]/70">
              Exempel – ingen bokning görs här.
            </p>
          </form>
        </div>
      </section>

      <section id="hitta" class="bg-[#eadccb]">
        <div class="mx-auto grid max-w-6xl lg:grid-cols-2">
          <div class="px-5 py-12 md:px-8">
            <p class="text-[11px] uppercase tracking-[0.22em] text-[#8a6234]">
              Hitta hit
            </p>
            <h2 class="mt-2 font-display text-3xl italic">Folkungagatan 48</h2>
            <p class="mt-4 max-w-sm text-sm text-[#5c4338]">
              Södermalm, ett stenkast från Medborgarplatsen. Tunnelbana
              Medborgarplatsen, buss längs Folkungagatan.
            </p>
            <p class="mt-6 text-sm text-[#5c4338]">
              08-567 890 12
              <br />
              bord@trattorianove.se
            </p>
          </div>
          <iframe
            title="Karta till Trattoria Nove"
            src="https://maps.google.com/maps?q=Folkungagatan+48,+Stockholm&hl=sv&z=16&output=embed"
            class="h-72 w-full border-0 lg:h-full lg:min-h-[22rem]"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          />
        </div>
      </section>
      <DemoExit />
    </div>
</DemoLayout>
